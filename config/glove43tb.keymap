#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <0 4 7 8>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
            layers = <0 4 7 8>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
            layers = <0 4>;
        };

        muhennkann_mac {
            bindings = <&to_layer_0 LANG2>;
            key-positions = <11 10>;
            layers = <7 8>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
            layers = <0 4 7 8>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
            layers = <0 4 7 8>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        nav {
            if-layers = <1 2>;
            then-layer = <3>;
        };

        mac_mouse {
            if-layers = <4 7>;
            then-layer = <8>;
        };

        mac_edit_function {
            if-layers = <1 7>;
            then-layer = <9>;
        };

        mac_num {
            if-layers = <2 7>;
            then-layer = <10>;
        };

        mac_edit_scroll {
            if-layers = <5 7>;
            then-layer = <9>;
        };

        mac_edit_bt {
            if-layers = <6 7>;
            then-layer = <9>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_mkp: lt_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_MOUSE_KEY";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // 1クリックで2回トリガーされても接続先が1つだけ進むよう、400ms以内の連続切替を無視する
        bt_step: bt_step {
            compatible = "zmk,behavior-bt-step";
            display-name = "BT Step";
            #binding-cells = <1>;
            cooldown-ms = <400>;
        };

        // 音量を上げる方向(FUNCTION の C_VOLUME_UP と同じ向き)に回すと次の接続先
        encoder_bt_step: encoder_bt_step {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt_step 0>, <&bt_step 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                    &kp T                                                     &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                    &kp G        &kp LS(LG(S))                &kp LEFT_SHIFT  &kp H        &kp J  &kp K      &kp L    &lt 5 SEMICOLON
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                    &kp B        &kp TAB                      &kp RCTRL       &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&mt LCTRL ESC     &kp LEFT_ALT  &kp LEFT_WIN  &lt_to_layer_0 6 LANG2   &lt 1 SPACE  &lt_to_layer_0 5 LANG1       &kp BACKSPACE   &lt 2 ENTER                             &kp DEL
            >;

            sensor-bindings = <&mouse_wheel_scroll SCRL_DOWN SCRL_UP>;
        };

        FUNCTION {
            bindings = <
&kp F1      &kp F2          &kp F3          &kp F4           &kp F5                                   &kp F6    &kp F7          &kp F8          &kp F9           &kp F10
&kp ESCAPE  &trans          &kp UP_ARROW    &mo 5            &kp DELETE     &trans        &kp F13     &mkp MB4  &mkp MB1        &kp UP_ARROW    &mkp MB2         &lt_mkp 5 MB3
&trans      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp BACKSPACE  &trans        &kp F11     &mkp MB5  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F12
&trans      &trans          &trans          &kp LC(X)        &kp LC(C)      &kp LC(V)     &trans      &trans                                                     &gresc
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUM {
            bindings = <
&kp DOUBLE_QUOTES         &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK                                                &kp LEFT_PARENTHESIS  &kp EXCLAMATION  &kp CARET  &kp LEFT_BRACKET  &kp DOLLAR
&kp COLON                 &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp RIGHT_BRACKET  &kp LC(LA(KP_NUMBER_0))      &kp AT_SIGN   &kp BACKSLASH         &kp MINUS        &kp PLUS   &kp HASH          &kp SINGLE_QUOTE
&mt LEFT_SHIFT UNDERSCORE &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp RIGHT_BRACE    &kp EQUAL                    &kp LS(INT3)  &kp PIPE              &kp LS(INT1)     &kp EQUAL  &kp LEFT_BRACE    &kp QUESTION
&trans                    &kp NUMBER_0  &kp DOT       &kp LC(X)     &kp LC(C)          &kp LC(V)                    &trans        &trans                                                                     &kp DEL
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp PAGE_UP                         &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END        &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &kp PAGE_DOWN  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans         &trans      &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans       &trans                                   &trans     &trans    &trans  &trans    &trans
&trans  &trans  &trans  &lt 5 RCTRL  &trans     &trans         &mkp MB3       &mkp MB4   &mkp MB1  &trans  &mkp MB2  &lt_mkp 5 MB3
&trans  &trans  &trans  &trans       &trans     &trans         &trans         &mkp MB5   &trans    &trans  &trans    &trans
&trans  &trans  &trans  &kp LC(X)    &kp LC(C)  &kp LC(V)      &trans         &trans                                 &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans     &trans                            &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LC(X)  &kp LC(C)  &kp LC(V)      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans          &trans        &trans        &trans        &trans                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans          &trans        &trans        &trans        &trans    &trans        &trans  &out OUT_TOG  &trans        &trans        &trans        &trans
&bt BT_CLR_ALL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &ind_con  &ind_bat      &trans  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans          &bootloader   &trans        &trans        &trans    &trans        &trans  &trans                                                  &bootloader
            >;

            sensor-bindings = <&encoder_bt_step>;
        };

        // 7-10: Mac 用 (BT プロファイル 3,4 接続時に src/os_layer.c が MAC を自動で有効化)
        MAC {
            bindings = <
&trans         &trans  &trans        &trans  &trans                                           &trans  &trans  &trans  &trans  &trans
&trans         &trans  &trans        &trans  &trans  &kp LG(LC(LS(NUMBER_4)))       &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans  &trans        &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&mt LGUI ESC   &trans  &kp LCTRL     &trans  &trans  &trans                         &trans  &trans                          &trans
            >;
        };

        MAC_MOUSE {
            bindings = <
&trans  &trans  &trans  &trans     &trans                            &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LG(X)  &kp LG(C)  &kp LG(V)      &trans  &trans                          &trans
            >;
        };

        MAC_EDIT {
            bindings = <
&trans  &trans  &trans  &trans     &trans                            &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LG(X)  &kp LG(C)  &kp LG(V)      &trans  &trans                          &trans
            >;
        };

        // MAC より上に置くため、NUM の Win 位置(.) と内側キーをここで戻す
        MAC_NUM {
            bindings = <
&trans  &trans        &trans   &trans     &trans                                       &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans   &trans     &trans     &kp LC(LA(KP_NUMBER_0))   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans   &trans     &trans     &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &kp DOT  &kp LG(X)  &kp LG(C)  &kp LG(V)                 &trans  &trans                          &trans
            >;
        };
    };
};
